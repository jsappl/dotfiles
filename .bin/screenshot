#!/usr/bin/env bash

# screenshot - Wayland screenshot (whole screen or selection) with swappy editor
# Usage: ./screenshot [full|select]  (defaults to select)

set -euo pipefail

MODE=${1:-select}
TIMESTAMP=$(date +%Y%m%d-%H%M%S)
OUTPUT="/tmp/screenshot-${TIMESTAMP}.png"

case "$MODE" in
full | fullscreen)
  sleep 3 # delay to allow user to prepare the screen
  grim - | swappy -f - -o "$OUTPUT"
  ;;
select | area)
  grim -g "$(slurp)" - | swappy -f - -o "$OUTPUT"
  ;;
window)
  GEOMETRY=$(swaymsg -t get_tree | jq -r '.. | select(.pid? and .visible?) | .rect | "\(.x),\(.y) \(.width)x\(.height)"' | slurp)
  grim -g "$GEOMETRY" - | swappy -f - -o "$OUTPUT"
  ;;
*)
  echo "Usage: $0 [full|select|window]" >&2
  echo "  full    - capture entire screen"
  echo "  select  - select area with mouse (default)"
  echo "  window  - hover over window to capture it"
  exit 1
  ;;
esac

echo "Screenshot saved: $OUTPUT"
